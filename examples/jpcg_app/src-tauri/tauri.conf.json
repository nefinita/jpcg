{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "剑网3PVP计算器（JPCG）",
  "version": "2.1.0-alpha.1",
  "identifier": "com.qinthirteen.jpcg",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "剑网3PVP计算器（JPCG）",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["data/shuxing/*.toml"],
    "externalBin": ["binaries/jpcg_updater"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
